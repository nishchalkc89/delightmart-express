# Delight Shopping Mart — your own Supabase project
# Copy this file to .env and fill in the two values from:
#   Supabase Dashboard → Project Settings → API
#
# Both values are PUBLIC browser values (safe in the website code).
# Security is enforced by the row-level security rules in supabase/setup.sql.
VITE_DELIGHT_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_DELIGHT_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Google sign-in (Google's own button). The Web application OAuth Client ID from
# Google Cloud Console → APIs & Services → Credentials. It is public, not a secret.
VITE_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com

# NEVER put the service_role / secret key in this file or anywhere in the website code.
# Payment secrets (eSewa, Khalti) will live in Supabase Edge Function secrets, not here.
