# Public browser values from your own Supabase project. Safe to expose; RLS remains the security boundary.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only. Never prefix this with VITE_ or commit a real value.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Provider secrets belong only in secure deployment secrets.
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
